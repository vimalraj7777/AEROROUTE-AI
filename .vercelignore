# The parallel Python app, tooling, and docs are not needed at runtime.
python/
scripts/
tests/
docs/
.vscode/

# Raw datasets are large; only the processed artifacts are shipped.
data/raw/flights/*.csv
data/raw/flights/readme.html
data/raw/weather/*.csv

# Redundant binary model artifacts (runtime uses the JSON exports).
models/*.joblib

# Build output is regenerated by Vercel.
dist/

*.log
.DS_Store
