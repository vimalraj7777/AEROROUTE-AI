# Optional: reserved for a future Gemini integration. The current app does not call Gemini.
# Keep provider keys in this server-side environment file, never in frontend source.
GEMINI_API_KEY=""

# Optional hosting URL for future integrations that need a public application URL.
APP_URL="MY_APP_URL"

# Set to true only after running the optional Kaggle importer.
AEROROUTE_USE_KAGGLE_DATA="false"
